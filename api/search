ce","locale":"en"},"659":{"id":"/en/docs/remotes-and-sensors-24","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#room-sensor","content":"CO₂ (ppm)","locale":"en"},"660":{"id":"/en/docs/remotes-and-sensors-25","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#room-sensor","content":"`1298`","locale":"en"},"661":{"id":"/en/docs/remotes-and-sensors-26","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#room-sensor","content":"Humidity (%)","locale":"en"},"662":{"id":"/en/docs/remotes-and-sensors-27","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#room-sensor","content":"`12A0`","locale":"en"},"663":{"id":"/en/docs/remotes-and-sensors-28","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#room-sensor","content":"Temperature","locale":"en"},"664":{"id":"/en/docs/remotes-and-sensors-29","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#room-sensor","content":"`12A0`, `12C0`","locale":"en"},"665":{"id":"/en/docs/remotes-and-sensors-30","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#room-sensor","content":"Ventilation demand (%)","locale":"en"},"666":{"id":"/en/docs/remotes-and-sensors-31","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#room-sensor","content":"`31E0`","locale":"en"},"667":{"id":"/en/docs/remotes-and-sensors-32","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#room-sensor","content":"Presence","locale":"en"},"668":{"id":"/en/docs/remotes-and-sensors-33","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#room-sensor","content":"`2E10`","locale":"en"},"