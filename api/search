ocale":"en"},"677":{"id":"/en/docs/remotes-and-sensors-42","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#sensors-with-buttons","content":"**Any button was pressed**","locale":"en"},"678":{"id":"/en/docs/remotes-and-sensors-43","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#naming","content":"New devices are called *Remote 29:123456* or *Room sensor 37:044778*. Rename them to something recognisable\n(*Kitchen remote*, *Living room CO₂*). The address stays visible under *Settings → Bus*.","locale":"en"},"679":{"id":"/en/docs/remotes-and-sensors-44","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"Every RAMSES device has an address `TT:NNNNNN`. The first two digits say something about the kind of device:","locale":"en"},"680":{"id":"/en/docs/remotes-and-sensors-45","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"Starts with","locale":"en"},"681":{"id":"/en/docs/remotes-and-sensors-46","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"Usually","locale":"en"},"682":{"id":"/en/docs/remotes-and-sensors-47","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"`18:`","locale":"en"},"683":{"id":"/en/docs/remotes-and-sensors-48","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"Gateway (ramses_esp, HGI80)","locale":"en"},"684":{"id":"/en/docs/remotes-and-sensors-49","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"`29:`","locale":"en"},"685":{"id":"/en/docs/remotes-and-sensors-50","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"Remote, or an Orcon unit","locale":"en"},"686":{"id":"/en/docs/remotes-and-sensors-51","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"`32:`","locale":"en"},"687":{"id":"/en/docs/remotes-and-sensors-52","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"Ventilation unit (Itho, Vasco, ClimaRad) or remote","locale":"en"},"688":{"id":"/en/docs/remotes-and-sensors-53","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"`37:`","locale":"en"},"689":{"id":"/en/docs/remotes-and-sensors-54","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"CO₂ sensor / control","locale":"en"},"690":{"id":"/en/docs/remotes-and-sensors-55","page_id":"/en/docs/remotes-and-sensors","tags":[],"type":"text","url":"/en/docs/remotes-and-sensors#recognising-addresses","content":"The app doesn't just look at the prefix but mostly at **which messages** a device sends. The role it determines that\nway is shown in the device finder.","locale":"en"},"691":{"id":"/en/docs/troubleshooting","page_id":"/en/docs/troubleshooting","type":"page","content":"Troubleshooting","breadcrumbs":["Documentation","Help"],"tags":[],"url":"/en/docs/troubleshooting","locale":"en"},"692":{"id":"/en/docs/troubleshooting-0","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#troubleshooting","content":"Troubleshooting","locale":"en"},"693":{"id":"/en/docs/troubleshooting-1","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#connection","content":"Connection","locale":"en"},"694":{"id":"/en/docs/troubleshooting-2","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#homey-doesnt-find-a-gateway","content":"Homey doesn't find a gateway","locale":"en"},"695":{"id":"/en/docs/troubleshooting-3","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#no-mqtt-broker-answered-at-this-address","content":"*No MQTT broker answered at this address*","locale":"en"},"696":{"id":"/en/docs/troubleshooting-4","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#the-gateway-keeps-becoming-unavailable","content":"The gateway keeps becoming unavailable","locale":"en"},"697":{"id":"/en/docs/troubleshooting-5","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#control","content":"Control","locale":"en"},"698":{"id":"/en/docs/troubleshooting-6","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#the-unit-doesnt-respond-to-homey","content":"The unit doesn't respond to Homey","locale":"en"},"699":{"id":"/en/docs/troubleshooting-7","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#no-unit-answered-while-binding","content":"*No unit answered* while binding","locale":"en"},"700":{"id":"/en/docs/troubleshooting-8","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#the-mode-in-homey-doesnt-match-the-unit","content":"The mode in Homey doesn't match the unit","locale":"en"},"701":{"id":"/en/docs/troubleshooting-9","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#finding-devices","content":"Finding devices","locale":"en"},"702":{"id":"/en/docs/troubleshooting-10","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#my-unit-remote-or-sensor-isnt-in-the-list","content":"My unit, remote or sensor isn't in the list","locale":"en"},"703":{"id":"/en/docs/troubleshooting-11","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#i-see-several-ventilation-units","content":"I see several ventilation units","locale":"en"},"704":{"id":"/en/docs/troubleshooting-12","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#suddenly-i-see-unknown-devices","content":"Suddenly I see *Unknown* devices","locale":"en"},"705":{"id":"/en/docs/troubleshooting-13","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#values","content":"Values","locale":"en"},"706":{"id":"/en/docs/troubleshooting-14","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#tiles-are-missing-co-temperature-filter","content":"Tiles are missing (CO₂, temperature, filter…)","locale":"en"},"707":{"id":"/en/docs/troubleshooting-15","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#the-fan-speed-is-a-number-from-0-to-4","content":"The fan speed is a number from 0 to 4","locale":"en"},"708":{"id":"/en/docs/troubleshooting-16","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#parameters-supported-by-this-unit-no","content":"*Parameters: Supported by this unit: No*","locale":"en"},"709":{"id":"/en/docs/troubleshooting-17","page_id":"/en/docs/troubleshooting","type":"heading","tags":[],"url":"/en/docs/troubleshooting#logs-for-a-bug-report","content":"Logs for a bug report","locale":"en"},"710":{"id":"/en/docs/troubleshooting-18","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#homey-doesnt-find-a-gateway","content":"*Connected, but no ramses_esp published anything on this broker.*","locale":"en"},"711":{"id":"/en/docs/troubleshooting-19","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#homey-doesnt-find-a-gateway","content":"Check in the ramses_esp that it is connected to **the same broker** (address, port, user, password).","locale":"en"},"712":{"id":"/en/docs/troubleshooting-20","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#homey-doesnt-find-a-gateway","content":"Does the ramses_esp get no Wi-Fi? Check through the serial console that\nthe ssid and password are right (case sensitive) and that it is a **2.4 GHz** network.","locale":"en"},"713":{"id":"/en/docs/troubleshooting-21","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#homey-doesnt-find-a-gateway","content":"Did you enter the password after the ssid or broker line? Run `wifi restart` or `reset` so it connects again.","locale":"en"},"714":{"id":"/en/docs/troubleshooting-22","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#homey-doesnt-find-a-gateway","content":"Use an MQTT client such as MQTT Explorer to see whether anything arrives under\n`RAMSES/GATEWAY/`.","locale":"en"},"715":{"id":"/en/docs/troubleshooting-23","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#homey-doesnt-find-a-gateway","content":"Homey listens for about 4 seconds. A ramses_esp that is just starting up may not be visible yet. In that case enter\nits address (`18:xxxxxx`) under *Gateway address* and try again.","locale":"en"},"716":{"id":"/en/docs/troubleshooting-24","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#no-mqtt-broker-answered-at-this-address","content":"Is the IP address right? With the MQTT Broker app it's your Homey's IP address.","locale":"en"},"717":{"id":"/en/docs/troubleshooting-25","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#no-mqtt-broker-answered-at-this-address","content":"Is the port right? Usually `1883`, or `8883` with TLS.","locale":"en"},"718":{"id":"/en/docs/troubleshooting-26","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#no-mqtt-broker-answered-at-this-address","content":"Is the broker app running? Open it and check its status.","locale":"en"},"719":{"id":"/en/docs/troubleshooting-27","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#the-gateway-keeps-becoming-unavailable","content":"*MQTT broker not reachable*: the broker is gone or its IP address changed. Give Homey (or your NAS) a fixed IP\naddress in your router.","locale":"en"},"720":{"id":"/en/docs/troubleshooting-28","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#the-gateway-keeps-becoming-unavailable","content":"*The ramses_esp reports that it is offline*: the ramses_esp has no power or no Wi-Fi. Check that it's reachable and\nthat the Wi-Fi is strong enough where it is.","locale":"en"},"721":{"id":"/en/docs/troubleshooting-29","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#the-unit-doesnt-respond-to-homey","content":"This is by far the most common problem. The unit only executes commands from devices it is **bound** to.","locale":"en"},"722":{"id":"/en/docs/troubleshooting-30","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#the-unit-doesnt-respond-to-homey","content":"Check *Settings → Control → Remote address* of the unit. If it's empty, or not an address bound to the unit, the\nunit ignores Homey.","locale":"en"},"723":{"id":"/en/docs/troubleshooting-31","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#the-unit-doesnt-respond-to-homey","content":"Don't know the address of a bound remote? Press that remote and see in the bus view which\naddress sends a `22F1` to your unit.","locale":"en"},"724":{"id":"/en/docs/troubleshooting-32","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#the-unit-doesnt-respond-to-homey","content":"Or bind Homey itself as a remote.","locale":"en"},"725":{"id":"/en/docs/troubleshooting-33","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#the-unit-doesnt-respond-to-homey","content":"The command arrives, but the unit does something else (e.g. *high* instead of *auto*)? Then the\nbrand is wrong. Choose the brand manually.","locale":"en"},"726":{"id":"/en/docs/troubleshooting-34","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#no-unit-answered-while-binding","content":"The unit was not in binding mode. On an Orcon: unplug, plug back in, and start binding **within 2 minutes**. Other\nbrands: see your unit's manual (look for *registering a remote* or *pairing*).","locale":"en"},"727":{"id":"/en/docs/troubleshooting-35","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#the-mode-in-homey-doesnt-match-the-unit","content":"By default Homey asks the unit for its status every 5 minutes. To see it sooner, use the card *Ask the unit for its\nstatus* or lower *Ask for status every*.","locale":"en"},"728":{"id":"/en/docs/troubleshooting-36","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#the-mode-in-homey-doesnt-match-the-unit","content":"Some units don't report their mode, only their speed. Homey then derives the mode from what the remotes send.","locale":"en"},"729":{"id":"/en/docs/troubleshooting-37","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#the-mode-in-homey-doesnt-match-the-unit","content":"Is the mode consistently wrong (e.g. *auto* where it says *high*)? Choose the right brand.","locale":"en"},"730":{"id":"/en/docs/troubleshooting-38","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#my-unit-remote-or-sensor-isnt-in-the-list","content":"**Unit**: press a button on the remote and only then continue. The unit answers and is heard that way.","locale":"en"},"731":{"id":"/en/docs/troubleshooting-39","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#my-unit-remote-or-sensor-isnt-in-the-list","content":"**Remote**: press a button while searching.","locale":"en"},"732":{"id":"/en/docs/troubleshooting-40","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#my-unit-remote-or-sensor-isnt-in-the-list","content":"**Room sensor**: sensors report every few minutes. Press the sensor's button if it has one, or wait a little longer and\ntry again.","locale":"en"},"733":{"id":"/en/docs/troubleshooting-41","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#my-unit-remote-or-sensor-isnt-in-the-list","content":"Check in the device finder whether the device is heard at all. If not, it's probably too\nfar from the ramses_esp.","locale":"en"},"734":{"id":"/en/docs/troubleshooting-42","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#i-see-several-ventilation-units","content":"In apartment buildings the gateway also hears the neighbours' units. Add **only your own unit**. Its address is on the\ntype plate or in your old configuration. Never send test commands to other people's units.","locale":"en"},"735":{"id":"/en/docs/troubleshooting-43","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#suddenly-i-see-unknown-devices","content":"Those are devices the app can't place yet, for example the neighbours', or a different kind of RAMSES device (such as\nan evohome thermostat). They do no harm.","locale":"en"},"736":{"id":"/en/docs/troubleshooting-44","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#tiles-are-missing-co-temperature-filter","content":"Capabilities only appear once the unit reports them. Give it a few minutes, or use *Ask the unit for its status*. If a\nvalue never shows up, your unit doesn't have that sensor or doesn't report it over RAMSES.","locale":"en"},"737":{"id":"/en/docs/troubleshooting-45","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#the-fan-speed-is-a-number-from-0-to-4","content":"Some units don't report a percentage but a **step number**. That's what the unit itself says; the app doesn't convert\nit.","locale":"en"},"738":{"id":"/en/docs/troubleshooting-46","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#parameters-supported-by-this-unit-no","content":"Your unit has no parameters that can be read over RAMSES. That's normal for mechanical extract units (such as an Orcon\nMVS-15); only heat recovery units have them.","locale":"en"},"739":{"id":"/en/docs/troubleshooting-47","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#logs-for-a-bug-report","content":"Something not working as expected? Open an issue and include:","locale":"en"},"740":{"id":"/en/docs/troubleshooting-48","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#logs-for-a-bug-report","content":"The brand and model of your unit (also shown under *Settings → Bus → Model*).","locale":"en"},"741":{"id":"/en/docs/troubleshooting-49","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#logs-for-a-bug-report","content":"A piece of **live traffic** from the bus view around the moment it goes wrong. Filter on\nyour unit's address.","locale":"en"},"742":{"id":"/en/docs/troubleshooting-50","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#logs-for-a-bug-report","content":"What you did, what you expected and what happened.","locale":"en"},"743":{"id":"/en/docs/troubleshooting-51","page_id":"/en/docs/troubleshooting","tags":[],"type":"text","url":"/en/docs/troubleshooting#logs-for-a-bug-report","content":"Optionally a diagnostics report: *Apps → RAMSES ESP → Send diagnostics report*.","locale":"en"},"744":{"id":"/en/docs/ventilation-unit","page_id":"/en/docs/ventilation-unit","type":"page","content":"Ventilation unit","breadcrumbs":["Documentation","Devices"],"tags":[],"url":"/en/docs/ventilation-unit","locale":"en"},"745":{"id":"/en/docs/ventilation-unit-0","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit","content":"Adding, controlling and configuring your heat recovery or mechanical ventilation unit.","locale":"en"},"746":{"id":"/en/docs/ventilation-unit-1","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#adding","content":"Adding","locale":"en"},"747":{"id":"/en/docs/ventilation-unit-2","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#making-sure-homey-may-control-the-unit","content":"Making sure Homey may control the unit","locale":"en"},"748":{"id":"/en/docs/ventilation-unit-3","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#option-1-use-the-address-of-an-existing-remote","content":"Option 1: use the address of an existing remote","locale":"en"},"749":{"id":"/en/docs/ventilation-unit-4","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#option-2-bind-homey-as-a-remote","content":"Option 2: bind Homey as a remote","locale":"en"},"750":{"id":"/en/docs/ventilation-unit-5","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#controlling","content":"Controlling","locale":"en"},"751":{"id":"/en/docs/ventilation-unit-6","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#fan-mode","content":"Fan mode","locale":"en"},"752":{"id":"/en/docs/ventilation-unit-7","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#boost","content":"Boost","locale":"en"},"753":{"id":"/en/docs/ventilation-unit-8","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#bypass","content":"Bypass","locale":"en"},"754":{"id":"/en/docs/ventilation-unit-9","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#filter","content":"Filter","locale":"en"},"755":{"id":"/en/docs/ventilation-unit-10","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#ventilation-demand","content":"Ventilation demand","locale":"en"},"756":{"id":"/en/docs/ventilation-unit-11","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#what-the-unit-shows","content":"What the unit shows","locale":"en"},"757":{"id":"/en/docs/ventilation-unit-12","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#settings","content":"Settings","locale":"en"},"758":{"id":"/en/docs/ventilation-unit-13","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#control","content":"Control","locale":"en"},"759":{"id":"/en/docs/ventilation-unit-14","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#brand","content":"Brand","locale":"en"},"760":{"id":"/en/docs/ventilation-unit-15","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#parameters-heat-recovery","content":"Parameters (heat recovery)","locale":"en"},"761":{"id":"/en/docs/ventilation-unit-16","page_id":"/en/docs/ventilation-unit","type":"heading","tags":[],"url":"/en/docs/ventilation-unit#bus","content":"Bus","locale":"en"},"762":{"id":"/en/docs/ventilation-unit-17","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#adding","content":"Go to **Devices → + → RAMSES ESP → Ventilation unit**.","locale":"en"},"763":{"id":"/en/docs/ventilation-unit-18","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#adding","content":"Homey lists the units the gateway has already heard. Is your unit missing? Press a button on your remote, wait a few\nseconds and continue. The unit answers and shows up in the list. Homey searches for up to 30 seconds.","locale":"en"},"764":{"id":"/en/docs/ventilation-unit-19","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#adding","content":"Pick your unit and click **Next**.","locale":"en"},"765":{"id":"/en/docs/ventilation-unit-20","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#adding","content":"**Living in an apartment building?** The gateway often hears the neighbours' units too. Only add your own unit. Its\naddress is on the unit's type plate, or listed as *FAN ID* in your old Home Assistant or ramses_cc configuration.\nNot sure? Check in the bus view which unit responds when you press your own remote.","locale":"en"},"766":{"id":"/en/docs/ventilation-unit-21","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#making-sure-homey-may-control-the-unit","content":"A RAMSES unit only executes commands from devices it is **bound** to. Homey therefore has to pose as such a device.\nThere are two ways:","locale":"en"},"767":{"id":"/en/docs/ventilation-unit-22","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-1-use-the-address-of-an-existing-remote","content":"Homey then sends commands *in the name of* a remote the unit already knows.","locale":"en"},"768":{"id":"/en/docs/ventilation-unit-23","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-1-use-the-address-of-an-existing-remote","content":"If the gateway has heard a remote talking to this unit, Homey fills in its address **automatically** when you add\nthe unit.","locale":"en"},"769":{"id":"/en/docs/ventilation-unit-24","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-1-use-the-address-of-an-existing-remote","content":"Otherwise enter it yourself: *Device → Settings → Control → Remote address*, e.g. `29:173894`.","locale":"en"},"770":{"id":"/en/docs/ventilation-unit-25","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-1-use-the-address-of-an-existing-remote","content":"Coming from Home Assistant with ramses_cc? Use the same (possibly *faked*) remote address as there.","locale":"en"},"771":{"id":"/en/docs/ventilation-unit-26","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-1-use-the-address-of-an-existing-remote","content":"While the field is empty, the device shows a warning: *Set the address of a remote the unit is bound to (device\nsettings) so Homey can control it.*","locale":"en"},"772":{"id":"/en/docs/ventilation-unit-27","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-2-bind-homey-as-a-remote","content":"Homey can also bind itself to the unit as a new remote of its own. You then don't need an existing remote address.","locale":"en"},"773":{"id":"/en/docs/ventilation-unit-28","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-2-bind-homey-as-a-remote","content":"Put the unit in **binding mode**. On an Orcon: unplug the unit and plug it back in. The unit then accepts new\ndevices for about 2 minutes.","locale":"en"},"774":{"id":"/en/docs/ventilation-unit-29","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-2-bind-homey-as-a-remote","content":"In Homey, open the device → **Settings** (gear) → **Maintenance** → **Bind Homey as a remote**.","locale":"en"},"775":{"id":"/en/docs/ventilation-unit-30","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-2-bind-homey-as-a-remote","content":"Homey picks a free address (`29:xxxxxx`), offers itself every 5 seconds and waits up to 90 seconds for the unit to\naccept.","locale":"en"},"776":{"id":"/en/docs/ventilation-unit-31","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-2-bind-homey-as-a-remote","content":"Done? The new address is shown under *Remote address* and you can control the unit.","locale":"en"},"777":{"id":"/en/docs/ventilation-unit-32","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-2-bind-homey-as-a-remote","content":"Only *this* unit may accept the binding, so a neighbour's unit that happens to be in binding mode too is not bound by\naccident.","locale":"en"},"778":{"id":"/en/docs/ventilation-unit-33","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#option-2-bind-homey-as-a-remote","content":"Getting *No unit answered*? The unit was not (or no longer) in binding mode. Repeat step 1 and start binding within 2\nminutes.","locale":"en"},"779":{"id":"/en/docs/ventilation-unit-34","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"The device card has a **Fan mode** picker:","locale":"en"},"780":{"id":"/en/docs/ventilation-unit-35","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"Mode","locale":"en"},"781":{"id":"/en/docs/ventilation-unit-36","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"Meaning","locale":"en"},"782":{"id":"/en/docs/ventilation-unit-37","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"**Low**","locale":"en"},"783":{"id":"/en/docs/ventilation-unit-38","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"Base ventilation","locale":"en"},"784":{"id":"/en/docs/ventilation-unit-39","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"**Medium**","locale":"en"},"785":{"id":"/en/docs/ventilation-unit-40","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"Normal","locale":"en"},"786":{"id":"/en/docs/ventilation-unit-41","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"**High**","locale":"en"},"787":{"id":"/en/docs/ventilation-unit-42","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"Maximum","locale":"en"},"788":{"id":"/en/docs/ventilation-unit-43","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"**Auto**","locale":"en"},"789":{"id":"/en/docs/ventilation-unit-44","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"The unit regulates itself based on its sensors (CO₂, humidity)","locale":"en"},"790":{"id":"/en/docs/ventilation-unit-45","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"**Away**","locale":"en"},"791":{"id":"/en/docs/ventilation-unit-46","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"Minimal ventilation","locale":"en"},"792":{"id":"/en/docs/ventilation-unit-47","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"**Off**","locale":"en"},"793":{"id":"/en/docs/ventilation-unit-48","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"Only if the brand supports it","locale":"en"},"794":{"id":"/en/docs/ventilation-unit-49","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"Not every brand has every mode. Choose a mode your brand doesn't have and Homey tells you which modes are available.","locale":"en"},"795":{"id":"/en/docs/ventilation-unit-50","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#fan-mode","content":"The mode is also updated when someone uses the **physical remote**; Homey hears it on the bus. On the dashboard tile\nthe mode is shown as a word (*Status*).","locale":"en"},"796":{"id":"/en/docs/ventilation-unit-51","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#boost","content":"With the flow card *Run on high for N minutes* the unit temporarily runs on high and then falls back. A boost lasts 1\nto 255 minutes. On an Orcon, Homey uses the same long boost as the real remote (high, then auto).","locale":"en"},"797":{"id":"/en/docs/ventilation-unit-52","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#bypass","content":"If your unit has a bypass (most heat recovery units), the **Bypass** picker appears as soon as the unit reports its\nbypass state: **Auto**, **Open** or **Closed**. Also through the flow card *Set the bypass to …*.","locale":"en"},"798":{"id":"/en/docs/ventilation-unit-53","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#filter","content":"**Filter days left** and **Filter left** show how much longer the filter will last.","locale":"en"},"799":{"id":"/en/docs/ventilation-unit-54","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#filter","content":"**Replace filter** (alarm) turns on when the unit reports that the filter needs replacing.","locale":"en"},"800":{"id":"/en/docs/ventilation-unit-55","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#filter","content":"After replacing it, reset the counter with the flow card **Reset the filter counter**.","locale":"en"},"801":{"id":"/en/docs/ventilation-unit-56","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#ventilation-demand","content":"Sensors such as an Orcon CO2 15RF, and the Virtual CO₂ sensor, tell the unit how much ventilation\nthey want, in %. In *Auto* the unit ventilates on the highest of them. **Ventilation demand** shows that highest\ndemand and **Demand from** the sensor that asks it, by its name in Homey. A sensor that stops repeating its demand\nno longer counts after 15 minutes. When every sensor asks 0 %, *Demand from* says *nobody*.","locale":"en"},"802":{"id":"/en/docs/ventilation-unit-57","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#ventilation-demand","content":"Many units, Orcon among them, don't report how fast they actually run, only their mode. The demand is then the best\nindication of what the unit does in *Auto*.","locale":"en"},"803":{"id":"/en/docs/ventilation-unit-58","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#what-the-unit-shows","content":"Capabilities appear **only once the unit reports them**. A unit without a CO₂ sensor never gets an empty CO₂ tile.\nAfter adding, it can therefore take a few minutes before everything shows up.","locale":"en"},"804":{"id":"/en/docs/ventilation-unit-59","page_id":"/en/docs/ventilation-unit","tags":[],"type":"text","url":"/en/docs/ventilation-unit#what-the-unit-shows","content":"