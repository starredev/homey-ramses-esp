{
  "triggers": [
    {
      "id": "fan_mode_changed",
      "title": {
        "en": "The fan mode changed",
        "nl": "De ventilatiestand veranderde"
      },
      "tokens": [
        {
          "name": "mode",
          "type": "string",
          "title": {
            "en": "Mode",
            "nl": "Stand"
          },
          "example": "high"
        },
        {
          "name": "source",
          "type": "string",
          "title": {
            "en": "Changed by",
            "nl": "Veranderd door"
          },
          "example": "remote"
        }
      ]
    },
    {
      "id": "fan_mode_changed_to",
