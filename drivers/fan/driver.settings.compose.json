      {
        "id": "remote_id",
        "type": "text",
        "label": {
          "en": "Remote address",
          "nl": "Adres van de afstandsbediening"
        },
        "value": "",
        "hint": {
          "en": "Homey sends commands in the name of a remote the unit is bound to, e.g. 29:173894. It is filled in automatically when the remote was seen on the bus.",
          "nl": "Homey verstuurt commando's namens een afstandsbediening waaraan de unit gekoppeld is, bv. 29:173894. Wordt automatisch ingevuld als de remote op de bus gezien is."
        }
      },
      {
        "id": "scheme",
        "type": "dropdown",
        "label": {
          "en": "Brand",
          "nl": "Merk"
        },
        "value": "auto",
        "hint": {
          "en": "Brands number their modes differently. Automatic uses Orcon numbering and switches when the unit's remotes reveal another brand.",
          "nl": "Merken nummeren hun standen verschillend. Automatisch gebruikt de Orcon-nummering en schakelt om als de remotes van de unit een ander merk verraden."
        },
        "values": [
          {
            "id": "auto",
            "label": {
              "en": "Automatic",
              "nl": "Automatisch"
            }
          },
          {
