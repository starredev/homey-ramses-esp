          {
            "id": "climarad",
            "label": {
              "en": "ClimaRad",
              "nl": "ClimaRad"
            }
          },
          {
            "id": "nuaire",
            "label": {
              "en": "Nuaire",
              "nl": "Nuaire"
            }
          }
        ]
      },
      {
        "id": "poll_interval",
        "type": "number",
        "label": {
          "en": "Ask for status every",
          "nl": "Status opvragen elke"
        },
        "value": 5,
        "min": 0,
        "max": 60,
        "units": {
          "en": "min",
          "nl": "min"
        },
        "hint": {
          "en": "0 turns asking off; the unit still reports on its own.",
          "nl": "0 zet opvragen uit; de unit meldt zich daarnaast zelf."
        }
      }
    ]
