{
  "name": "io.github.starredev.ramses",
  "version": "1.0.3",
  "description": "Homey app for RAMSES II (868 MHz) ventilation and climate devices through a ramses_esp gateway over MQTT",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Bryan",
  "repository": {
    "type": "git",
    "url": "https://github.com/starredev/homey-ramses-esp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "npx --yes --package=typescript@5 tsc --project jsconfig.json",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"lib/**/*.js\" --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=85 \"test/*.test.js\"",
    "validate": "homey app validate --level publish",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run validate"
  },
  "dependencies": {
    "mqtt": "^5.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^65.1.0",
    "globals": "^17.13.0"
  }
}
